#!/bin/sh
set -e

# Prerequisites for signing artifacts (publishToMavenCentral below):
#   - gpg, gpg-agent and a pinentry program installed (e.g. `brew install gnupg pinentry` on macOS,
#     `apt install gnupg pinentry-curses` on Linux)
#   - the signing private key imported into your local GPG keyring
#   - ~/.gradle/gradle.properties containing: signing.gnupg.keyName=<your key id>
#   - GPG_TTY exported in your shell (e.g. `export GPG_TTY=$(tty)`), so gpg-agent can prompt
#     for the key passphrase in this terminal
# See gradle/publish-module.gradle for how signing is wired up (uses signing.useGpgCmd()).

version=$1

if [ -z "$version" ] ; then
  echo "Usage: ./release 7.19.0"
  exit 0
fi

if [ ! -d "../selenide-web" ]
then
    echo "Directory ../selenide-web doesn't exist"
    exit 1
fi

branch=$(git branch --show-current)
if [ "$branch" != "main" ]
then
    echo "Current branch is not 'main': '$branch'"
    exit 1
fi

# Check MCP Registry prerequisites up front, so that a broken setup fails before anything is published.
if ! command -v mcp-publisher >/dev/null 2>&1
then
    echo "mcp-publisher is not installed (e.g. 'brew install mcp-publisher')"
    exit 1
fi

mcp_key_pem="$HOME/.ssh/mcp-registry-selenide-org.pem"
if [ ! -f "$mcp_key_pem" ]
then
    echo "MCP Registry key file not found: $mcp_key_pem"
    exit 1
fi

# Requires OpenSSL 3+ in PATH (e.g. `brew install openssl`): macOS's built-in LibreSSL can't read Ed25519 keys.
mcp_key_file=$(mktemp)
trap 'rm -f "$mcp_key_file"' EXIT
openssl pkey -in "$mcp_key_pem" -outform DER | tail -c 32 | xxd -p -c 64 | tr -d '\n' > "$mcp_key_file"
if [ "$(wc -c < "$mcp_key_file")" -ne 64 ]
then
    echo "Failed to extract MCP Registry key from $mcp_key_pem (is OpenSSL 3+ in PATH? found: $(openssl version))"
    exit 1
fi

echo "Releasing version: ${version}"

# Build everything
./gradlew clean check :modules:cli:shadowJar javadocForSite
rm -rf "modules/cli/npm/jar/*.jar"
cp modules/cli/build/libs/selenide-cli-*.jar modules/cli/npm/jar/
rm -rf modules/cli/npm/skills
cp -r modules/cli/skills modules/cli/npm/skills

# Publish JARs
./gradlew publishToMavenLocal -P signing.enabled
./gradlew publishToMavenCentral -P signing.enabled --no-parallel --info

# Publish javadoc on site
rm -fr "../selenide-web/static/javadoc/current/*"
cp -r modules/aggregate/build/javadoc/. ../selenide-web/static/javadoc/current/
cd ../selenide-web || exit 2
git add "static/javadoc/current"
git commit -m "publish javadoc for Selenide ${version}"
git push
cd - || exit 3

# Publish NPM modules

npm adduser

cd mcp-server
npm version "$version" --no-git-tag-version --allow-same-version
npm publish --access public -i

# Publish to MCP Registry (https://registry.modelcontextprotocol.io) as "org.selenide/mcp".
# Prerequisites: `brew install mcp-publisher`, and the Ed25519 private key whose public part is in
# the "v=MCPv1; ..." TXT record of selenide.org, stored in ~/.ssh/mcp-registry-selenide-org.pem
node -e 'const fs = require("fs"); const j = JSON.parse(fs.readFileSync("server.json"));
  j.version = j.packages[0].version = process.argv[1];
  fs.writeFileSync("server.json", JSON.stringify(j, null, 2) + "\n");' "$version"
mcp-publisher login dns --domain selenide.org --private-key-file "$mcp_key_file"
mcp-publisher publish
mcp-publisher logout
cd -

cd mcp-server-legacy
npm version "$version" --no-git-tag-version --allow-same-version
npm publish -i
npm deprecate selenide-mcp@"*" "selenide-mcp has moved to @selenide/mcp. Please update your config to use @selenide/mcp instead."
cd -

cd modules/cli/npm
npm version "$version" --no-git-tag-version --allow-same-version
npm publish --access public -i
cd -

npm logout

# Add git tag
git tag -a "v${version}" -m "released selenide ${version}"
git push origin --tags
